# PostgreSQL connection string (required)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# Secret used to sign admin session JWTs (required in production)
AUTH_SECRET="change-me-to-a-long-random-string"

# First admin account (used by the seed script)
ADMIN_EMAIL="admin@organic-chemistry.site"
ADMIN_PASSWORD="Admin@12345"

# Public base URL of the deployed site (used for SEO / sitemap / OpenGraph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
